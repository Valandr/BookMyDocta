{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.vue",
    "test": "jest --config jest.config.ts",
    "coverage": "jest --config jest.config.ts --coverage",
    "test:e2e": "env -u ELECTRON_RUN_AS_NODE -u ELECTRON_NO_ATTACH_CONSOLE cypress run",
    "storybook": "HOME=. storybook dev -p 6006 --config-dir storybook",
    "build-storybook": "HOME=. storybook build --config-dir storybook"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@storybook/addon-essentials": "^7.0.6",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/vue3-vite": "^8.6.14",
    "@tailwindcss/postcss": "^4.1.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/vue3-jest": "^29.2.6",
    "autoprefixer": "^10.4.21",
    "cypress": "^14.5.4",
    "eslint": "^9.26.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.6",
    "ts-jest": "^29.3.2",
    "typescript": "^5.8.3",
    "vite": "^8.0.10"
  }
}
